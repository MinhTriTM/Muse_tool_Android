<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_mystic_bronze"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header: Minimalist Note 20 Ultra 5G VN Badge & Version -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:text="MUSE • NOTE20 ULTRA 5G VN"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_version_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v2.4.0 • OTA"
            android:textColor="#E2E8F0"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Middle Row: Minimalist Free Credits vs Outstanding Balance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Free Credits Còn Lại"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_free_credits_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$6.40"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_free_credits_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="≈ 162,880₫ • In Use"
                android:textColor="#5EEAD4"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Outstanding Balance"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_outstanding_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$4.85"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_outstanding_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khi hết Free Credit"
                android:textColor="#FDA4AF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Period Summary Strip -->
    <TextView
        android:id="@+id/widget_period_breakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Ngày $1.85  ·  Tuần $6.42  ·  Tháng $14.90  ·  Tổng $28.45"
        android:textColor="#CBD5E1"
        android:textSize="10.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_profile_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kazuto Yui · Zero-Logout Active"
            android:textColor="#64748B"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="2dp"
            android:text="Đồng bộ ↻"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
